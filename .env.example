# =========================================================
#  Smart Git CLI - Environment Variables (.env)
# =========================================================
#
#  QURULUM:
#  1) Bu fayli `.env` adi ile kopyalayin:
#       copy .env.example .env          (Windows)
#       cp .env.example .env            (Linux / macOS)
#
#  2) Asagidaki `OPENAI_API_KEY` deyisenine oz API acharini yazin.
#     Acharini buradan götur: https://platform.openai.com/api-keys
#
#  3) `.env` fayli avtomatik olaraq yuklenir - smart-git onu oxuyur.
#     `.env` gitignore edilib, ona gore gizli acharlar commit olunmur.
#
#===================================================================

# ---- ZORUNLU ----
# OpenAI API acharin. "sk-..." ile baqlayir.
OPENAI_API_KEY=sk-sizin-api-achariniz-buraya

# ---- KONFIGURASIYA (istegi bagli) ----
# Istifade edilecek model. Standard: gpt-4o-mini (ucuz ve suretli).
# Isterseniz bura basqa OpenAI modelinin adini yaza bilersiz.
SMART_GIT_MODEL=gpt-4o-mini